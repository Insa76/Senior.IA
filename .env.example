# Groq
GROQ_API_KEY=PEGAR_API_KEY_NUEVA
GROQ_MODEL=openai/gpt-oss-20b

# WhatsApp Cloud API (no subir credenciales reales a GitHub)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=
WHATSAPP_API_VERSION=v26.0

# Web Push (generar una pareja VAPID nueva)
VAPID_SUBJECT=mailto:contacto@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Persistencia: si DATABASE_URL existe, se usa PostgreSQL; si no, se usa profiles.json local.
DATABASE_URL=
DATABASE_SSL=true
PG_POOL_MAX=5
SENIORIA_DATA_DIR=.

# Render asigna PORT automáticamente. Localmente se usa 3000.
PORT=3000
